# Contact form delivery (app/api/contact/route.ts) via Resend. Copy to .env.local and fill in.
# Without RESEND_API_KEY the form endpoint returns 503 and the form shows its failure state.
RESEND_API_KEY=
# Inbox that receives enquiries (default: ask@daveroai.com)
CONTACT_TO=ask@daveroai.com
# Sender; the domain must be verified in Resend
CONTACT_FROM="DaVero AI Website <website@daveroai.com>"

# Spam protection (all optional; app/api/contact/route.ts + lib/contact-shield.ts).
# Secret that signs the form's render-time token (time trap). Set a long random value in production:
#   openssl rand -base64 32
# Unset: tokens are unsigned but the 3 s / 2 h timing check still runs.
FORM_SECRET=
# Cloudflare Turnstile. Set BOTH to turn it on; either missing = off and the form works without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST, for rate limits and duplicate checks shared by every server instance
# (5 per IP per 10 min, 20 per IP per day). Set BOTH to turn it on; otherwise in-memory limits only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
